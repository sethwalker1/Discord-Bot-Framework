{
  "name": "discord-bot-template",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:register": "tsx watch src/index.ts --register",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.59.1",
    "@sentry/node": "^10.47.0",
    "@sentry/profiling-node": "^10.47.0",
    "cross-env": "^10.1.0",
    "discord.js": "^14.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "6.24.0",
      "minimatch": "9.0.7",
      "tar": "7.5.11",
      "picomatch": ">=4.0.4"
    }
  }
}
